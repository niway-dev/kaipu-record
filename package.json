{
  "name": "kaipu",
  "version": "1.0.0",
  "private": true,
  "description": "A monorepo template with DDD + Hexagonal Architecture, auth, deployment configs, and a Todo CRUD example",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "4.3.6",
      "@types/bun": "^1.3.4",
      "hono": "4.12.3",
      "@orpc/contract": "1.13.5",
      "@orpc/server": "1.13.5",
      "@orpc/openapi": "1.13.5",
      "@orpc/client": "1.13.5",
      "@orpc/openapi-client": "1.13.5",
      "@orpc/tanstack-query": "1.13.5",
      "better-auth": "1.4.18",
      "@tailwindcss/vite": "4.1.8",
      "tailwindcss": "4.1.18",
      "@vitejs/plugin-react": "5.1.2",
      "tsdown": "0.18.4",
      "vite": "7.3.0",
      "typescript": "5.9.3"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:tracked": "git ls-files | grep -E '\\.(ts|tsx|js|jsx|json|jsonc|md|mdx)$' | xargs oxfmt --write",
    "check": "bun run lint && bun run format",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:no-cache": "turbo run build --force",
    "check-types": "turbo run check-types",
    "dev:web-hono": "turbo run dev -F web-hono",
    "dev:server-hono": "turbo run dev -F server-hono",
    "db:command": "dotenvx run -f apps/<application>/.env -- turbo run db:command -F @kaipu/infra-db",
    "db:push": "dotenvx run -f apps/server-hono/.env -- turbo run db:push -F @kaipu/infra-db",
    "db:studio": "dotenvx run -f apps/server-hono/.env -- turbo run db:studio -F @kaipu/infra-db",
    "db:generate": "dotenvx run -f apps/server-hono/.env -- turbo run db:generate -F @kaipu/infra-db",
    "db:migrate": "dotenvx run -f apps/server-hono/.env -- turbo run db:migrate -F @kaipu/infra-db"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251213.0",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "jose": "^6.1.3",
    "lint-staged": "^16.1.2",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.34.0",
    "turbo": "^2.6.3",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*": [
      "oxlint",
      "oxfmt --write"
    ]
  },
  "packageManager": "bun@1.3.4"
}
