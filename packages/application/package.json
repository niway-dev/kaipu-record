{
  "name": "@kaipu/application",
  "version": "1.0.0",
  "description": "Application layer — shared use cases for all server-side consumers (Elysia, TanStack serverFn, Astro, cron jobs)",
  "keywords": [
    "application",
    "server-only",
    "use-cases"
  ],
  "license": "ISC",
  "author": "",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev:watch": "tsdown --watch",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kaipu/domain": "workspace:*",
    "@types/node": "^22.14.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  },
  "packageManager": "bun@1.3.4"
}
