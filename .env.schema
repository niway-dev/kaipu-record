# Root env schema — shared plugin setup and the environment switch.
# Each app has its own .env.schema that @imports this one and declares its vars.
# Design: /specs/2026-09-17-infisical-varlock-secrets-migration
#
# Values live in Infisical; this file only declares what exists. The one thing
# that never travels with git is the "secret zero" below — it goes in .env.local
# (gitignored) on a laptop, and CI uses OIDC instead.

# @plugin(@varlock/infisical-plugin)

# Local development reads the `dev` environment via Universal Auth.
# @initInfisical(id=dev, projectId=57a29646-d9c1-4bcf-a61e-434ddb21eeb9, environment=dev, clientId=$INFISICAL_CLIENT_ID, clientSecret=$INFISICAL_CLIENT_SECRET, cacheTtl="1h")

# @defaultSensitive=false @defaultRequired=infer @currentEnv=$APP_ENV
# ---

# Selects which Infisical environment the forEnv() resolvers reach for.
# @type=enum(development, production, test)
APP_ENV=development

# --- secret zero -------------------------------------------------------------
# Only ever set in .env.local. CI authenticates with OIDC and leaves these empty.
# @type=infisicalClientId @required=false
INFISICAL_CLIENT_ID=
# Used by varlock to authenticate, never injected into the app (that's @internal).
# @type=infisicalClientSecret @sensitive @internal @required=false
INFISICAL_CLIENT_SECRET=
