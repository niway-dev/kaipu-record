{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaipu-web",
  "compatibility_date": "2025-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  // Custom domains for the public site. Requires the `kaipu.app` zone to live in
  // the same Cloudflare account; on deploy, Wrangler provisions the proxied DNS
  // records + SSL automatically. The API is reached via the Service Binding below
  // (same-origin proxy), so it needs no public domain of its own.
  "routes": [
    { "pattern": "kaipu.app", "custom_domain": true },
    { "pattern": "www.kaipu.app", "custom_domain": true },
  ],
  // Version URLs for `wrangler versions upload`, which is what preview-web.yml
  // runs. This is independent of `workers_dev`: that one would publish the
  // DEPLOYED worker at kaipu-web.<subdomain>.workers.dev, a second public origin
  // for production that bypasses the kaipu.app zone's rules. It stays off. This
  // only gives each uploaded version its own <prefix>-kaipu-web.<subdomain>
  // .workers.dev address, which routes no production traffic.
  //
  // Wrangler leaves an existing value alone when the key is absent, so it has to
  // be explicit to turn on. One timing fact, read from wrangler's own source
  // (4.63.0, src/triggers/deploy.ts): `versions upload` only READS the flag from
  // Cloudflare, and only a deploy — or the dashboard toggle under Settings →
  // Domains & Routes → Preview URLs — WRITES it. This line therefore takes
  // effect on the next release, while the toggle works immediately; it exists so
  // deploys preserve the decision rather than to apply it. Two things follow
  // from enabling it: the URLs are
  // public (restrict them with Cloudflare Access under the worker's Preview URLs
  // settings), and a version runs with the worker's real secrets and service
  // bindings, so it reads production data. It is the last look before a tag, not
  // a sandbox.
  "preview_urls": true,
  "services": [
    {
      "binding": "API_SERVICE",
      "service": "kaipu-api",
    },
  ],
}
