# Database
DATABASE_URL=

# Server URL — the server-hono API's origin, WITH scheme (no service binding locally,
# the proxy does a plain fetch() to this, which fails silently on a bare host:port).
VITE_SERVER_URL=http://localhost:3000

# Public base URL of the R2 bucket that hosts the desktop installers (download/latest/*.dmg).
VITE_PUBLIC_DOWNLOAD_URL=https://updates.kaipu.app

# Cookieless PostHog for the website (NIW2-477). Leave VITE_POSTHOG_KEY empty to turn analytics off.
# Browser events go to /ingest on this app, which proxies to PostHog; the host below only sets the
# app link PostHog uses. Needs "cookieless server hash mode" enabled in the PostHog project.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
