# Database
DATABASE_URL=

# Server URL — the server-hono API's origin, WITH scheme (no service binding locally,
# the proxy does a plain fetch() to this, which fails silently on a bare host:port).
VITE_SERVER_URL=http://localhost:3000

# Public base URL of the R2 bucket that hosts the desktop installers (download/latest/*.dmg).
VITE_PUBLIC_DOWNLOAD_URL=https://updates.kaipu.app
