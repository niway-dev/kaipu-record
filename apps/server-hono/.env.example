# Database
DATABASE_URL=

# A disposable Neon branch; the integration suite creates a throwaway user per run and
# deletes only that user's rows. Leave empty to skip the @kaipu/infra-db integration suite.
TEST_DATABASE_URL=

# Better-auth
# To set BETTER_AUTH_SECRET let's use = openssl rand -base64 32
BETTER_AUTH_SECRET=
# BETTER_AUTH_URL is the WEB origin, NOT the API: http://localhost:3001 in dev,
# https://kaipu.app in prod. The web Worker proxies /api/auth/*, so Better Auth builds
# OAuth redirect URIs from it and the OAuth state cookie lives on that origin. No trailing
# slash. Google redirect URI = $BETTER_AUTH_URL/api/auth/callback/google.
# BETTER_AUTH_URL=http://localhost:3001

# Google sign-in. Optional: Google is registered only when BOTH are set; otherwise the API
# boots, logs one warning, and email+password keeps working. Runbook:
# apps/documentation/src/content/docs/deployment/google-oauth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CORS_ORIGIN=

# Cloudflare R2 (S3-compatible) — cloud recordings storage. Optional: the API
# still boots without them, and the recording endpoints report "Cloud storage
# is not configured" until all four are set. R2_BUCKET is the private bucket
# (Public Access off, no custom domain) — see the "R2 storage architecture" and
# "Cloud recordings" docs under apps/documentation/src/content/docs/backlog/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
