{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaipu-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-31",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  // Cloud sweep (src/scheduled.ts): releases expired reservations, retries deletes, drains the
  // account purge queue, reconciles accounting. PROPOSAL (plan 01 Task 0) — not approved.
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
}
