{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaipu-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-31",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "preview_urls": true,
  // Every 15 minutes: expired upload reservations, pending R2 deletes, deleted-account purge.
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
