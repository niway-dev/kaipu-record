# Same database as kaipu-api. Server-only; never use a VITE_ prefix for secrets.
DATABASE_URL=
# Explicit Better Auth user IDs, comma separated. Empty denies everyone.
CONSOLE_ADMIN_USER_IDS=
# Add the Console origin to kaipu-api's CORS_ORIGIN (Better Auth trusted origins).
# localhost supports the secure auth cookies in local browser development.
CONSOLE_API_URL=http://localhost:3000
CONSOLE_ENVIRONMENT=Development
