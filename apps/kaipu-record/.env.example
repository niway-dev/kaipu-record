# ─────────────────────────────────────────────────────────────────────────────
# kaipu-record — environment
#
# electron-vite loads a SINGLE .env from this directory. The prefix decides
# which process gets the variable (it is NOT one file per layer):
#
#   VITE_*          → renderer  (read via import.meta.env.VITE_*)
#   MAIN_VITE_*     → main      (read via import.meta.env.MAIN_VITE_*)
#   PRELOAD_VITE_*  → preload   (read via import.meta.env.PRELOAD_VITE_*)
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored;
# this `.env.example` is the committed template.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostHog (feature flags + error tracking) ─────────────────────────────────
# Runs in the renderer (posthog-js), so it uses the VITE_ prefix.
# The project API key is PUBLIC (it ships inside the app) — safe to commit a
# placeholder here. Get it from PostHog → Settings → Project → Project API Key.
# If these are empty/undefined, PostHog simply does not start and the app keeps
# working offline with flags at their safe defaults.
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Identity (multi-surface filtering) ───────────────────────────────────────
# One PostHog account/key is shared across surfaces. These two are registered as
# super-properties on every event + error so you can filter by product/surface
# in PostHog (e.g. when the backend and web frontend also report later).
#   product → the whole suite. Always "kaipu-recorder".
#   surface → which app reports. For THIS app it is invariant ("desktop"); the
#             code hardcodes that as a fallback, so this override is optional.
VITE_POSTHOG_PRODUCT=kaipu-recorder
VITE_POSTHOG_SURFACE=desktop
