# ─────────────────────────────────────────────────────────────────────────────
# kaipu-record — code signing & notarization (macOS / Windows)
#
# These are BUILD-TIME secrets consumed by electron-builder, NOT app runtime
# config. They are deliberately NOT prefixed with VITE_/MAIN_VITE_ so they can
# never leak into the bundled app — electron-vite only inlines prefixed vars.
#
# Variable names are the ones electron-builder / @electron/notarize read from
# the environment automatically, so no extra wiring is needed.
#
# USAGE
#   Local:  cp .env.signing.example .env.signing  → fill in → before building:
#             set -a; source .env.signing; set +a
#   CI:     do NOT use this file — put each value in GitHub Actions Secrets and
#           base64-encode the .p12 / .p8 binaries.
#
# SECURITY
#   - .env.signing is gitignored. The .p12 and .p8 files must live OUTSIDE the
#     repo (e.g. ~/.private_keys/) — point the *_LINK / *_KEY vars at absolute
#     paths. Never commit the certificate or the API key.
# ─────────────────────────────────────────────────────────────────────────────

# ── Signing certificate (Developer ID Application) ───────────────────────────
# Absolute path to the exported .p12 (or a base64 string of it for CI).
CSC_LINK=/Users/you/.private_keys/developer-id-application.p12
# The password you set when exporting the .p12 from Keychain Access.
CSC_KEY_PASSWORD=

# ── Apple team ───────────────────────────────────────────────────────────────
# developer.apple.com → Account → Membership details → Team ID (10 chars).
APPLE_TEAM_ID=

# ── Notarization (App Store Connect API key — recommended) ───────────────────
# appstoreconnect.apple.com → Users and Access → Integrations → App Store Connect API
# Issuer ID (UUID at the top of the keys table).
APPLE_API_ISSUER=
# Key ID (10 chars, the key's row).
APPLE_API_KEY_ID=
# Absolute path to the downloaded .p8 (one-time download — keep it safe).
APPLE_API_KEY=/Users/you/.private_keys/AuthKey_XXXXXXXXXX.p8

# ── (Optional) Windows code signing ──────────────────────────────────────────
# Only when you sign the Windows build too. Leave blank for now.
# WIN_CSC_LINK=
# WIN_CSC_KEY_PASSWORD=
