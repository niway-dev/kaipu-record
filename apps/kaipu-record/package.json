{
  "name": "kaipu-record",
  "version": "0.6.2",
  "description": "Kaipu Record — local-first screen + camera recorder for macOS.",
  "homepage": "https://kaipu.app",
  "author": "Niway",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "oxfmt --write .",
    "lint": "oxlint .",
    "check-types:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "check-types:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "check-types": "bun run check-types:node && bun run check-types:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bash ../../scripts/with-env.sh --tags kaipu-record -- sh -c \"bun run build && playwright test\"",
    "cursor-track:check": "bun run scripts/cursor-track-check.ts",
    "start": "electron-vite preview",
    "dev": "bash ../../scripts/with-env.sh --tags kaipu-record -- electron-vite dev",
    "build": "bun run check-types && electron-vite build",
    "build:unpack": "bash ../../scripts/rebuild-native.sh && bun run build && electron-builder --dir",
    "build:win": "bash ../../scripts/rebuild-native.sh && bun run build && electron-builder --win",
    "build:mac": "bash scripts/build-mac-local.sh",
    "build:linux": "bash ../../scripts/rebuild-native.sh && electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@kaipu/i18n": "workspace:*",
    "@kaipu/tokens": "workspace:*",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-switch": "^1.3.0",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.18.0",
    "mediabunny": "^1.49.0",
    "posthog-js": "^1.395.0",
    "posthog-node": "^5.38.6",
    "react-router-dom": "^7.17.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "electron": "^39.2.6",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.9"
  }
}
