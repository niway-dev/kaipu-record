# Copy to .env.local (gitignored) and fill in from the password manager.
#
# This is the whole "secret zero": one Infisical machine-identity credential.
# Everything else resolves from Infisical through the .env.schema files.
# CI never uses this file — GitHub Actions authenticates with OIDC instead.
#
# Where these come from: Infisical → Access Control → Machine Identities →
# `local-dev` (Universal Auth, read-only on `dev`). The client secret is shown
# exactly once at creation — store it in the password manager right then.
#
# Losing a laptop means rotating this one pair, nothing else.

INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
